        "right": {
          "val": "none",
          "sz": 0,
          "color": "auto"
        },
        "insideH": {
          "val": "none",
          "sz": 0,
          "color": "auto"
        },
        "insideV": {
          "val": "none",
          "sz": 0,
          "color": "auto"
        },
        "header_bottom": {
          "val": "single",
          "sz": 6,
          "color": "000000"
        }
      },
      "cell_margins": {
        "top": 40,
        "left": 80,
        "bottom": 40,
        "right": 80
      },
      "v_align": "center",
      "header": {
        "bold": true,
        "align": "center",
        "repeat": true
      },
      "body": {
        "align": null
      },
      "column_widths": "keep"
