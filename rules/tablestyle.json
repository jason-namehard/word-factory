{
  "schema": 1,
  "name": "表格款式（外置规则；可改可加）",
  "styles": {
    "三线表": {
      "note": "报告里最常用的学术款：上下粗线 + 表头下细线，无竖线",
      "table_align": "center",
      "table_layout": "fixed",
      "borders": {
        "top": {
          "val": "single",
          "sz": 12,
          "color": "000000"
        },
        "bottom": {
          "val": "single",
          "sz": 12,
          "color": "000000"
        },
        "left": {
          "val": "none",
          "sz": 0,
          "color": "auto"
